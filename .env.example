# ================================
# MongoDB Configuration
# ================================

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

USE_DB_AUTH=true
DB_AUTH_SOURCE=admin

# MongoDB connection with authentication
DB_CONN_STR=mongodb://admin:password123@mongodb:27017/perseverance?authSource=admin

# ================================
# Application Configuration
# ================================

PORT=3100

# ================================
# Docker Image Tags (CI/CD will override these)
# ================================

BACKEND_IMAGE_TAG=jayakrishnasai/ssp-backend:latest
FRONTEND_IMAGE_TAG=jayakrishnasai/ssp-frontend:latest

# ================================
# Grafana Configuration
# ================================

GRAFANA_HOST_PORT=3000
ALERTMANAGER_HOST_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/ssp-overview.json
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=your_email@gmail.com
GRAFANA_SMTP_PASSWORD=your_app_password
GRAFANA_SMTP_FROM_ADDRESS=your_email@gmail.com
GRAFANA_SMTP_FROM_NAME=SSP Grafana
GRAFANA_ALERT_EMAIL_TO=alerts@example.com

# ================================
# Frontend / CORS Configuration
# ================================

FRONTEND_URL=http://32.236.15.154
ALLOW_ANY_ORIGIN=false

# ================================
# Optional (Future Use / Scaling)
# ================================

NODE_ENV=production
